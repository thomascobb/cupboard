rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Membership lives in Firestore, not in this file:
    //   households/{hid}/members/{email}
    // Those docs are written only by scripts/admin.mjs (Admin SDK bypasses rules),
    // so this file is identical for every deployment and safe in a public repo.
    function allowed(hid) {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/households/$(hid)/members/$(request.auth.token.email.lower()));
    }

    // Household doc (name etc.): members read, admin script writes.
    match /households/{hid} {
      allow read: if allowed(hid);
      allow write: if false;

      // Member list: members can see who's in, only the admin script changes it.
      match /members/{email} {
        allow read: if allowed(hid);
        allow write: if false;
      }

      // Inventory data: members read and write.
      match /{collection}/{docId} {
        allow read, write: if allowed(hid)
          && collection in ['products', 'lots', 'transactions', 'settings'];
      }
    }

    // Everything else is closed.
  }
}
