{
  "name": "cupboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emu": "firebase emulators:exec --only firestore,auth --project demo-cupboard \"vite --mode emulator\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run tests/unit",
    "test:watch": "vitest tests/unit",
    "test:rules": "firebase emulators:exec --only firestore,auth --project demo-cupboard \"vitest run tests/emulator --no-file-parallelism --test-timeout=20000\"",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/make-icons.mjs",
    "admin": "node scripts/admin.mjs",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:emu": "firebase emulators:exec --only firestore,auth --project demo-cupboard \"playwright test -c playwright.emulator.config.ts\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "1.63.0",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "~15.35.0",
    "typescript": "^5.9.3",
    "vite": "8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "~5.1.0",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "firebase": "13.2.0"
  }
}
